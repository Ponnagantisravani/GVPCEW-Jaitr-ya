DATABASE_URL=postgresql://...
DATABASE_SSL_MODE=require
JWT_SECRET=replace-with-a-long-random-value
PORT=4000
ENROLLMENT_API_KEY=replace-with-a-long-random-value
DATASET_ADMIN_API_KEY=replace-with-a-different-long-random-value
S3_BUCKET=gvpcew-face-dataset
S3_REGION=auto
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...

# Required for online student face enrollment
FACE_API_URL=http://127.0.0.1:8000
FACE_SERVICE_KEY=replace-with-a-separate-long-random-value
# Attendance verifier endpoint (POST); must verify enrolled identity AND liveness.
# This is separate from the development /analyze face detector.
ATTENDANCE_VERIFIER_URL=
ATTENDANCE_VERIFIER_KEY=
# Face services must enforce this key and return livenessVerified: true. Do not
# expose the face service publicly or use a development-only detector in production.
# Set NODE_ENV=production for deployment
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=0

# Mobile attendance: calibrate the threshold using the exact 192-dimensional model.
MOBILE_FACE_THRESHOLD=
PLAY_INTEGRITY_PACKAGE_NAME=
# Comma-separated base64url signing-certificate SHA256 digests.
PLAY_INTEGRITY_CERT_SHA256=
# Service account JSON, kept only on the server; enable the Play Integrity API.
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=

# Stage 3: Firebase Cloud Messaging HTTP v1; server-only credentials.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# Numeric linked Google Cloud project number for Standard Play Integrity requests (public).
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=
